{
  "name": "rpc-chrome",
  "version": "1.1.9",
  "description": "",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeeeby/rpc-chrome.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "build:fixture": "node scripts/build-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run build:fixture && playwright test",
    "test:e2e": "npm run build && npm run build:fixture && playwright test --project=e2e",
    "test:e2e:headed": "npm run build && npm run build:fixture && playwright test --project=e2e --headed",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "chrome",
    "chrome-extension",
    "messaging",
    "rpc",
    "typescript",
    "chrome-messaging",
    "extension",
    "typed-messaging",
    "chrome-communication"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.4",
    "@types/node": "^22.20.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "js-base64": "^3.9.3"
  }
}
