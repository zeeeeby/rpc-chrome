{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": ["ES2020", "DOM"],
		"moduleResolution": "node",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"declaration": true,
		"types": ["chrome", "node"]
	},
	"include": ["src", "tests", "e2e", "scripts", "playwright.config.ts"],
	"exclude": ["node_modules", "dist", ".e2e-extension", ".e2e-profile*"]
}
